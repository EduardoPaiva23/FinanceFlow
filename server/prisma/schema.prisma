datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TipoLancamento {
  receita
  despesa
}

enum OrigemLancamento {
  manual
  pdf
  ofx
}

model Categoria {
  id           String       @id @default(uuid())
  nome         String       @unique
  lancamentos  Lancamento[]
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  @@map("categorias")
}

model Usuario {
  id           String       @id @default(uuid())
  email        String       @unique
  senhaHash    String       @map("senha_hash")
  nome         String?
  lancamentos  Lancamento[]
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  @@map("usuarios")
}

model Lancamento {
  id           String         @id @default(uuid())
  descricao    String
  valor        Decimal        @db.Decimal(12, 2)
  tipo         TipoLancamento
  data         String
  categoriaId  String         @map("categoria_id")
  categoria    Categoria      @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  usuarioId    String         @map("usuario_id")
  usuario      Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Parcelamento: todas as parcelas de uma mesma compra compartilham o parcelamentoId.
  parcelamentoId String?          @map("parcelamento_id")
  parcelaNumero  Int?             @map("parcela_numero")
  parcelaTotal   Int?             @map("parcela_total")

  // Importação: a chave é gravada na criação e nunca muda, para que o lançamento
  // continue sendo reconhecido mesmo depois de editado pelo usuário.
  origem          OrigemLancamento @default(manual)
  fitid           String?
  chaveImportacao String?          @map("chave_importacao")

  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt

  @@index([data])
  @@index([categoriaId])
  @@index([usuarioId])
  @@index([usuarioId, chaveImportacao])
  @@index([usuarioId, fitid])
  @@index([parcelamentoId])
  @@map("lancamentos")
}
